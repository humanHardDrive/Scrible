# Writes a C++ file holding a file's bytes, for data built into the app (the font).
# Usage: cmake -DIN=file -DOUT=out.cpp -DNAME=kSymbol -P embed.cmake
# It defines `extern const unsigned char NAME[]` and `extern const size_t NAME##Size`
# in namespace scrible.

file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" chars)
math(EXPR size "${chars} / 2")
# Sixteen bytes a line.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
string(REGEX REPLACE "((0x..,){16})" "\\1\n" hex "${hex}")
file(WRITE "${OUT}" "// Generated by cmake/embed.cmake from ${IN}.\n#include <cstddef>\nnamespace scrible {\n"
                    "extern const unsigned char ${NAME}[];\nextern const size_t ${NAME}Size;\n"
                    "const unsigned char ${NAME}[] = {\n${hex}};\nconst size_t ${NAME}Size = ${size};\n}\n")
