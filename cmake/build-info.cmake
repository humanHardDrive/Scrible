# Writes BuildInfo.h with the commit being built (git describe: a tag like v0.1.0
# when built at one, else the short hash, plus "-dirty" for uncommitted changes)
# and that commit's date. Runs on every build; the header only changes when they do.
# Usage: cmake -DSOURCE_DIR=... -DOUT=.../BuildInfo.h -P build-info.cmake

set(commit "")
set(date "")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --tags --always --dirty --abbrev=7
                  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" log -1 --format=%cs
                  OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()

set(content "// Generated by cmake/build-info.cmake.\n#define SCRIBLE_COMMIT \"${commit}\"\n#define SCRIBLE_COMMIT_DATE \"${date}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
